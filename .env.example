# Local development logging only. Do not commit real credentials or platform env-pull output.
LOG_DIR=./logs
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# Optional server-side OAuth secret for the chatgpt_confidential client (client_secret_post).
# CONNECTOR_CHATGPT_CLIENT_SECRET: generate from at least 32 independent random bytes,
# encode as canonical unpadded base64url (43-128 characters), and configure privately
# in the server environment and the intended client's OAuth settings. Never reuse
# FEISHU_APP_SECRET or commit a real value. Omit the key when disabled; blank is invalid.
